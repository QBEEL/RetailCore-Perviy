# Единственная точка входа снаружи. Сертификат Let's Encrypt Caddy получает и
# продлевает сам — отдельного certbot и задания в cron не требуется.

retail.qbeely.ru {
	encode zstd gzip

	# Схема API наружу не отдаётся. Клиент адреса методов знает из своего кода,
	# а в открытом виде она нужна только тому, кто ищет, за что зацепиться:
	# в логах за первые же минуты работы видны переборы `/.env` и подобного.
	# Ответ 404, а не 403: он не подтверждает, что тут вообще что-то есть.
	@schema path /docs /docs/* /redoc /redoc/* /openapi.json
	handle @schema {
		respond 404
	}

	# Отбор оплат возвращает всю историю одним ответом — несколько мегабайт
	# JSON. Без увеличенных таймаутов медленный канал в офисе рвал бы запрос.
	handle {
		reverse_proxy api:8000 {
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	# Заголовки, которые ничего не стоят и закрывают целый класс мелких проблем.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
