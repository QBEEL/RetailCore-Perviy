# Образец окружения. Рабочий .env лежит только на сервере и в git не попадает.
# Пароль сгенерировать, а не придумывать: openssl rand -base64 24

POSTGRES_DB=retailcore
POSTGRES_USER=retailcore
POSTGRES_PASSWORD=замените-меня

# ИИ-правка заметок (необязательно). Ключ — из Google AI Studio
# (aistudio.google.com); подписка Gemini Pro для API не подходит.
# GEMINI_API_KEY=
# AI_MODEL=gemini-3.5-flash-lite
# AI_DAILY_LIMIT=20
# Если с сервера Google закрыт, исходящий прокси: http://хост:порт
# AI_HTTPS_PROXY=
