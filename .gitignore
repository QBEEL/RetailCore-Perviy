# --- рабочие данные -----------------------------------------------------------
# Репозиторий публичный: прайсы, выгрузки 1С, заполненные бланки и контрагенты
# в него попадать не должны. Правило по расширению — чтобы новый файл,
# положенный в папку проекта, не утёк по недосмотру.
*.xlsx
*.xlsm
*.xls
*.csv
Для заказа/
Для переоценки/
Для планирования/
1c report/
календарь/
samples/

# --- сборка и окружение ---------------------------------------------------------
.venv/
build/
dist/
*.spec.bak
__pycache__/
*.py[cod]
.pytest_cache/

# --- журналы и локальные базы -----------------------------------------------------
*.log
*.db
*.db-wal
*.db-shm

# --- персональные данные ----------------------------------------------------------
# Списки учётных записей содержат ФИО сотрудников. Репозиторий публичный —
# им место в папке профиля, рядом с базой.
accounts*.json

# --- секреты сервера ------------------------------------------------------------
# Пароль базы и ключ подписи токенов живут только на сервере. В репозитории
# остаётся server/.env.example — с пустыми значениями.
.env
server/.env

# --- среда разработки ---------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
